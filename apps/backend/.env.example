# Backend Specific Environment Configuration
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
SECRET_KEY=dev_secret_key_change_in_production_min32chars!

# Database Connections (For future integration milestones)
DATABASE_URL=postgresql+asyncpg://sih_admin:sih_dev_password@localhost:5432/sih_investigation_db
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_dev_password

# CORS Settings
FRONTEND_URL=http://localhost:3000

# Development reviewer identity (DEV MODE ONLY).
# This value is used as the reviewer identity for human-review actions when
# no authentication system is active.  It MUST be removed and replaced by
# a real authenticated user identity in production or staging deployments.
# Authentication is NOT enabled in this milestone.
DEV_REVIEWER_ID=DEV-REVIEWER-001

# Extraction
EXTRACTION_PROVIDER=MOCK
