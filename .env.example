# Application Environment
APP_ENV=development
SECRET_KEY=dev_secret_key_change_in_production_min32chars!

# FastAPI Backend Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# PostgreSQL Database Configuration
POSTGRES_USER=sih_admin
POSTGRES_PASSWORD=sih_dev_password
POSTGRES_DB=sih_investigation_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sih_admin:sih_dev_password@localhost:5432/sih_investigation_db

# Neo4j Graph Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_dev_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Next.js Frontend Configuration
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
